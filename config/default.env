# zsh-ai-complete defaults — copy to ~/.config/zsh-ai-complete/config.env
# AI_COMPLETE_MODEL is required and has no default; set it explicitly.

AI_COMPLETE_ENDPOINT=http://127.0.0.1:8000/v1
AI_COMPLETE_TIMEOUT=30
AI_COMPLETE_HISTORY=8
AI_COMPLETE_ENABLED=1

# Required — set to a model id oMLX has available (see GET /v1/models):
# AI_COMPLETE_MODEL=gemma-4-31B-it-MLX-8bit

# If oMLX auth is enabled, set the same key from the oMLX setup/admin panel:
# AI_COMPLETE_API_KEY=your-omlx-api-key
