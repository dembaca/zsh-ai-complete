#!/usr/bin/env bash
# ai-complete — resolve free-text intent to a shell command via local oMLX.
#
# Usage: ai-complete [--] <prompt...>
#
# stdout: command only
# stderr: diagnostics / safety warning label
# exit 0: ok (clean)
# exit 2: ok with safety warning (command still on stdout)
# exit 1: error

set -euo pipefail

AI_COMPLETE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/context.sh
source "$AI_COMPLETE_ROOT/lib/context.sh"
# shellcheck source=../lib/safety.sh
source "$AI_COMPLETE_ROOT/lib/safety.sh"

AI_COMPLETE_ENDPOINT="${AI_COMPLETE_ENDPOINT:-http://127.0.0.1:8000/v1}"
AI_COMPLETE_TIMEOUT="${AI_COMPLETE_TIMEOUT:-30}"

usage() {
  cat <<'EOF'
Usage: ai-complete [--] <prompt...>

Requires AI_COMPLETE_MODEL. Optional:
  AI_COMPLETE_ENDPOINT  (default http://127.0.0.1:8000/v1)
  AI_COMPLETE_API_KEY   (Bearer token if oMLX auth is enabled)
  AI_COMPLETE_TIMEOUT   (default 30)
  AI_COMPLETE_HISTORY   (default 8)
EOF
}

ai_complete_sanitize() {
  local text="$1"
  # Strip <think>…</think> blocks emitted by reasoning models (Qwen, etc.)
  text="$(printf '%s' "$text" | sed '/<think>/,/<\/think>/d')"
  # Trim whitespace
  text="$(printf '%s' "$text" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  # Strip markdown fences if the model ignored instructions
  if [[ "$text" == \`\`\`* ]]; then
    text="$(printf '%s\n' "$text" | sed -e '1{/^```/d;}' -e '${/^```$/d;}')"
    text="$(printf '%s' "$text" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  fi
  # Drop a leading language tag line like ```bash already handled; also "bash\ncmd"
  if [[ "$text" == bash$'\n'* || "$text" == sh$'\n'* || "$text" == zsh$'\n'* ]]; then
    text="${text#*$'\n'}"
  fi
  printf '%s' "$text"
}

ai_complete_system_prompt() {
  cat <<'EOF'
You are a shell command translator. Your output is fed directly to a shell — it must be executable as-is.

Rules (strict):
- Output ONLY the raw shell command. No reasoning, no explanation, no commentary, no alternatives.
- No markdown, no code fences, no backticks wrapping the whole command.
- The very first character of your response must be the first character of the command.
- One command only. If multiple steps are needed, chain them with && or |.

Context: macOS zsh. Prefer BSD/macOS flags. Use the provided cwd, git, history, and session history when relevant.
session history contains the last few commands with their exit codes and terminal output, oldest first — use it to understand the workflow and errors.
If the intent is ambiguous, choose the most common safe interpretation.
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  if [[ "${1:-}" == "--" ]]; then
    shift
  fi

  if [[ $# -lt 1 ]]; then
    echo "ai-complete: missing prompt" >&2
    usage >&2
    exit 1
  fi

  if [[ -z "${AI_COMPLETE_MODEL:-}" ]]; then
    echo "ai-complete: AI_COMPLETE_MODEL is required (no silent default)" >&2
    exit 1
  fi

  local prompt="$*"
  local context
  context="$(ai_complete_collect_context)"

  local user_content
  user_content="$(cat <<EOF
Context:
$context

Intent:
$prompt
EOF
)"

  local payload
  payload="$(jq -n \
    --arg model "$AI_COMPLETE_MODEL" \
    --arg system "$(ai_complete_system_prompt)" \
    --arg user "$user_content" \
    '{
      model: $model,
      temperature: 0.1,
      max_tokens: 256,
      messages: [
        {role: "system", content: $system},
        {role: "user", content: $user}
      ]
    }')"

  if [[ "${AI_COMPLETE_DEBUG:-}" == "1" ]]; then
    local debug_file="${TMPDIR%/}/ai-complete-debug.json"
    printf '%s\n' "$payload" | jq . > "$debug_file" 2>/dev/null \
      || printf '%s\n' "$payload" > "$debug_file"
    printf 'ai-complete: debug payload → %s\n' "$debug_file" >&2
  fi

  local url="${AI_COMPLETE_ENDPOINT%/}/chat/completions"
  local http_code
  local tmp auth_tmp
  tmp="$(mktemp)"
  auth_tmp=""
  _ai_complete_cleanup() { rm -f "$tmp" "${tmp}.err" "${auth_tmp}"; }
  trap _ai_complete_cleanup EXIT

  local -a curl_headers=(-H 'Content-Type: application/json')
  if [[ -n "${AI_COMPLETE_API_KEY:-}" ]]; then
    # Write the auth header to a private temp file to keep the key out of
    # the process list (ps aux shows curl arguments to all local users).
    auth_tmp="$(mktemp)"
    chmod 600 "$auth_tmp"
    printf 'Authorization: Bearer %s\r\n' "${AI_COMPLETE_API_KEY}" > "$auth_tmp"
    curl_headers+=(--header "@${auth_tmp}")
  fi

  http_code="$(curl -sS -o "$tmp" -w '%{http_code}' \
    --max-time "$AI_COMPLETE_TIMEOUT" \
    "${curl_headers[@]}" \
    -d "$payload" \
    "$url" 2>"${tmp}.err" || true)"

  if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
    local err
    err="$(cat "${tmp}.err" 2>/dev/null || true)"
    echo "ai-complete: request failed (HTTP ${http_code:-0}) to $url" >&2
    if [[ -s "$tmp" ]]; then
      echo "ai-complete: $(head -c 500 "$tmp")" >&2
    fi
    if [[ -n "$err" ]]; then
      echo "ai-complete: $err" >&2
    fi
    rm -f "${tmp}.err"
    exit 1
  fi
  rm -f "${tmp}.err"

  local raw
  raw="$(jq -er '.choices[0].message.content // empty' "$tmp" 2>/dev/null || true)"
  if [[ -z "$raw" ]]; then
    echo "ai-complete: empty model response" >&2
    exit 1
  fi

  local cmd
  cmd="$(ai_complete_sanitize "$raw")"
  if [[ -z "$cmd" ]]; then
    echo "ai-complete: sanitized response empty" >&2
    exit 1
  fi

  local warn_label=""
  set +e
  warn_label="$(ai_complete_safety_check "$cmd")"
  local safety_rc=$?
  set -e

  printf '%s\n' "$cmd"

  if [[ $safety_rc -eq 2 ]]; then
    echo "ai-complete: warning: $warn_label" >&2
    exit 2
  fi

  exit 0
}

main "$@"
